# SEC EDGAR requires a descriptive User-Agent on every request: "Name email@example.com"
# Requests without this get blocked. Do not skip this.
EDGAR_USER_AGENT="Your Name your_email@example.com"

# Optional: only needed if you wire up an embeddings API instead of local sentence-transformers
EMBEDDINGS_API_KEY=

# Optional: only needed once you actually use S3 for filing cache (Section 6 of spec)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional: explicitly disable automatic S3 caching even if a bucket is set.
# The local_workflow command sets this for its own process automatically.
EQUITY_LOCAL_ONLY=

# Optional: Anthropic API key, only needed for the agent layer (Phase 4+) and MCP server
ANTHROPIC_API_KEY=

# Standard AWS credential chain supports SSO/profile credentials as well.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_PREFIX=equity-research

# Scheduled monitor reads this JSON object under AWS_S3_PREFIX in the bucket.
MONITOR_WATCHLIST_KEY=monitor/watchlist.json

# Public web application (private local mode defaults to false).
LEDGER_AUTH_REQUIRED=false
LEDGER_PUBLIC_ORIGIN=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
DATABASE_URL=
# Generate once with Fernet.generate_key(); never commit the actual key.
LEDGER_BACKUP_KEY=
# Optional AI synthesis requires both a provider key and an explicit model ID.
ANTHROPIC_MODEL=
# Optional quote/news provider. Verify redistribution rights for your plan.
FINNHUB_API_KEY=
