# SEC EDGAR requires a descriptive User-Agent on every request: "Name email@example.com"
# Requests without this get blocked. Do not skip this.
EDGAR_USER_AGENT="Your Name your_email@example.com"

# Optional: only needed if you wire up an embeddings API instead of local sentence-transformers
EMBEDDINGS_API_KEY=

# Optional: only needed once you actually use S3 for filing cache (Section 6 of spec)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Optional: Anthropic API key, only needed for the agent layer (Phase 4+) and MCP server
ANTHROPIC_API_KEY=
