LEDGER_AUTH_REQUIRED=true
LEDGER_PUBLIC_ORIGIN=https://ledger.example.com
COGNITO_DOMAIN=https://YOUR-DOMAIN.auth.us-east-2.amazoncognito.com
COGNITO_CLIENT_ID=YOUR_PUBLIC_APP_CLIENT_ID
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/YOUR_POOL_ID
DATABASE_URL=postgresql://ledger:REPLACE@YOUR-RDS-ENDPOINT:5432/ledger?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-ca.pem
